{
    "name": "nails/driver-geo-code-google",
    "keywords":
    [
        "Nails",
        "Shed Collective",
        "CodeIgniter",
        "GeoCode Module",
        "Driver",
        "Google Geocoding API"
    ],
    "homepage": "http://nailsapp.co.uk/modules/geo-code/driver/google",
    "description": "This is the \"Google\" driver for the Nails GeoCode module.",
    "license": "MIT",
    "authors":
    [
        {
            "name": "Pablo de la Pena",
            "email": "p@nailsapp.co.uk",
            "homepage": "http://nailsapp.co.uk",
            "role": "Developer"
        }
    ],
    "support":
    {
        "email": "hello@nailsapp.co.uk"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require":
    {
        "nails/module-geo-code": "dev-feature/pre-new-admin"
    },
    "require-dev":
    {
        "phpunit/phpunit": "9.*",
        "phpstan/phpstan": "1.*"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload":
    {
        "psr-4":
        {
            "Nails\\GeoCode\\Driver\\": "src/",
            "Nails\\GeoCode\\Driver\\Google\\": "src/Google/"
        }
    },
    "extra":
    {
        "nails":
        {
            "name": "Google Geocoding API",
            "type": "driver",
            "forModule": "nails/module-geo-code",
            "namespace": "Nails\\GeoCode\\Driver\\Google\\",
            "data":
            {
                "namespace": "Nails\\GeoCode\\Driver\\",
                "class": "Google"
            }
        }
    }
}